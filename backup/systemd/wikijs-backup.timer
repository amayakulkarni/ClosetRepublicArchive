[Unit]
Description=Run the Wiki.js backup daily

[Timer]
# 03:30 server time, with a random delay of up to 10 minutes
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=600
# Run at boot if the server was off at the scheduled time
Persistent=true
Unit=wikijs-backup.service

[Install]
WantedBy=timers.target
