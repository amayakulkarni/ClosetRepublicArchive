[Unit]
Description=Wiki.js PostgreSQL backup
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ClosetRepublicArchive/backup
ExecStart=/usr/bin/node /opt/ClosetRepublicArchive/backup/src/backup.js --env /opt/ClosetRepublicArchive/.env
# Backup files are private to root.
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
