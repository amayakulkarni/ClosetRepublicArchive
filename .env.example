# Closet Republic wiki: environment settings
#
# 1. Copy this file:            cp .env.example .env
# 2. Lock it down:              chmod 600 .env
# 3. Generate each password:    openssl rand -hex 32
#    (hex output has no characters that need quoting or escaping)
# 4. Replace every CHANGE_ME value below.
#
# Never commit .env. It is listed in .gitignore.

# ---------------------------------------------------------------------------
# Wiki.js database connection (read by docker-compose.yml)
# ---------------------------------------------------------------------------
DB_TYPE=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=wikijs
DB_USER=wikijs
# openssl rand -hex 32
DB_PASS=CHANGE_ME_64_HEX_CHARS_FROM_OPENSSL_RAND

# Host port Wiki.js is published on (127.0.0.1 only). nginx proxies to it.
WIKI_PORT=40010

# ---------------------------------------------------------------------------
# Backup app (backup/). Not passed into any container.
# ---------------------------------------------------------------------------
# Folder for dump files. Created with mode 700 if missing.
BACKUP_DIR=/opt/wikijs/backups
# Delete dumps older than this many days...
BACKUP_RETENTION_DAYS=14
# ...but always keep at least this many of the newest dumps.
BACKUP_MIN_KEEP=3
# Name of the Postgres container (container_name in docker-compose.yml).
BACKUP_DB_CONTAINER=wikijs-db
# Abort pg_dump if it runs longer than this.
BACKUP_TIMEOUT_MINUTES=30
# Also email after a successful backup (true/false). Failures always email.
BACKUP_NOTIFY_SUCCESS=false

# ---------------------------------------------------------------------------
# Alert email (backup failures). Same SMTP account as the main site works.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
# 465 = implicit TLS; 587 = STARTTLS
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
# Require STARTTLS on port 587 (keep true in production).
SMTP_REQUIRE_TLS=true
MAIL_FROM="Closet Republic Wiki <wiki@closetrepublic.com>"
# Address that receives backup failure alerts.
BACKUP_ALERT_EMAIL=CHANGE_ME@example.com
