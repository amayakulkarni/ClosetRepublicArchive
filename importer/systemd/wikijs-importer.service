[Unit]
Description=Wiki.js content importer (drafts only)
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ClosetRepublicArchive/importer
ExecStart=/usr/bin/node /opt/ClosetRepublicArchive/importer/src/import.js --env /opt/ClosetRepublicArchive/importer/.env.local
# State and run reports are private to root.
UMask=0077
Nice=10
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
